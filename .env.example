# Pflicht in Produktion
BASE_URL=https://funke.example.com
COOKIE_SECURE=1            # nur hinter HTTPS
TRUST_PROXY=1              # wenn hinter Reverse-Proxy (liest X-Forwarded-For)
ADMIN_TOKEN=               # langes Zufallspasswort: openssl rand -hex 32
DB_PATH=/data/funke.db     # auf persistentem Volume

# Optional
PORT=3000
RESEND_API_KEY=            # ohne Key werden Mails nur ins Log geschrieben
MAIL_FROM=Funke <hallo@funke.example.com>
PLUS_ENABLED=0             # Bezahlfunktion existiert nicht; auf 0 lassen
PICKS_ANYTIME=0            # nur für Tests: 1 liefert Vorschläge sofort
